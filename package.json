{
  "name": "record-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": ">=11 <13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "format": "prettier --write .",
    "hooks:install": "husky",
    "format:check": "prettier --check .",
    "lint:code": "eslint . --max-warnings 0",
    "lint:styles": "stylelint '**/*.css' --allow-empty-input --max-warnings 0",
    "lint:docs": "markdownlint-cli2",
    "lint": "npm run lint:code && npm run lint:styles && npm run lint:docs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project packages/repository-policy/tsconfig.build.json && tsc --project packages/record-domain/tsconfig.build.json && tsc --project packages/server-config/tsconfig.build.json && tsc --project packages/record-storage/tsconfig.build.json && tsc --project packages/case-repository/tsconfig.build.json && tsc --project packages/web/tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:browser": "playwright test",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "check:secrets": "secretlint '**/*'",
    "check:repository": "node scripts/check-repository.ts",
    "check:dependencies": "npm audit --audit-level=high",
    "check:licenses": "license-checker-rseidelsohn --excludePrivatePackages --onlyAllow 'MIT;MIT-0;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;CC0-1.0;CC-BY-4.0;CC-BY-3.0;Unlicense;BlueOak-1.0.0;Python-2.0;PSF-2.0;MPL-2.0;Artistic-2.0;WTFPL' --summary",
    "verify:commit": "npm run check:repository && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:mutation && npm run build && npm run test:browser && npm run test:postgres && npm run check:secrets && npm run check:dependencies && npm run check:licenses"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "license-checker-rseidelsohn": "5.0.1",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.8",
    "secretlint": "13.0.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
