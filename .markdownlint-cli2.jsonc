{
  "globs": ["**/*.md"],
  "ignores": [
    "**/application-design.md",
    "**/session-log.md",
    "node_modules/**",
    ".tools/**",
    ".stryker-tmp/**",
    "coverage/**",
    "reports/**",
    "playwright-report/**",
    "test-results/**",
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD060": false,
  },
}
