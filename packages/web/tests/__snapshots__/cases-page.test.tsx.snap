exports[`renders an honest saved-case empty state without fabricated records 1`] = `"<main id="main-content" class="page" tabindex="-1"><div class="page-intro"><p class="eyebrow">CASE REVIEW / SAVED CASES</p><h1>Existing cases</h1><p class="lede">Return to a case workspace and continue reviewing the record.</p></div><section class="empty-state panel" aria-labelledby="empty-cases-heading"><span class="empty-symbol" aria-hidden="true">—</span><h2 id="empty-cases-heading">Case storage is not connected</h2><p>This preview does not create or retrieve saved cases. No court records are available in this workspace.</p><a class="button primary-button" href="/upload">Prepare a case record</a></section></main>"`;
