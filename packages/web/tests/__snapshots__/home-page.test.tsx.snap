// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders the empty case workspace with the two starting actions 1`] = `"<main id="main-content" class="page home-page" tabindex="-1"><div class="page-intro"><p class="eyebrow">CASE REVIEW / WORKSPACE</p><h1>Your case workspace</h1><p class="lede">A clear starting point for reviewing the record, following citations, and organizing the issues raised by each party.</p></div><section class="start-grid" aria-label="Start reviewing"><article class="start-card primary-card"><span class="card-symbol document-symbol" aria-hidden="true"></span><p class="eyebrow">START A NEW CASE</p><h2>Bring the record together</h2><p>Select the briefs, administrative decision, and supporting documents for one case.</p><a class="button primary-button" href="/upload">Upload case record <span aria-hidden="true">↗</span></a><p class="card-note">PDF, DOC, DOCX, XLSX, TIF, and TIFF</p></article><article class="start-card"><span class="card-symbol folder-symbol" aria-hidden="true"></span><p class="eyebrow">RETURN TO A CASE</p><h2>Continue your review</h2><p>Open an existing workspace to return to the record and your source-linked review.</p><a class="button secondary-button" href="/cases">Open existing case <span aria-hidden="true">→</span></a><p class="card-note">Saved synthetic case metadata appears on the next page.</p></article></section><section class="recent-section" aria-labelledby="recent-heading"><div class="section-heading"><h2 id="recent-heading">Recent cases</h2><span class="quiet-badge">Local preview</span></div><div class="empty-state"><span class="empty-symbol" aria-hidden="true">—</span><h3>Prepare synthetic documents</h3><p>Select synthetic documents locally. A configured development API can register originals, but processing is unavailable. Browse drafts from the Saved cases page.</p><a class="text-link" href="/upload">Prepare a case record <span aria-hidden="true">→</span></a></div></section><aside class="review-principle"><span class="principle-label">SOURCE-FIRST REVIEW</span><p>The planned workspace will connect each extracted detail to the record. Judicial findings and decisions remain with the reviewer.</p></aside></main>"`;
