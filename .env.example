# Future server-side development settings; the browser preview does not load this file.
# Keep actual values in the ignored root .env and use synthetic documents only.
APP_ENV=development
DATA_CLASSIFICATION=synthetic
AUTH_MODE=development
BIND_ADDRESS=127.0.0.1
# Use a separate synthetic-only PostgreSQL database on 127.0.0.1:55432.
# Never copy the real password into this example.
DEVELOPMENT_DATABASE_PASSWORD=
# Optional synthetic-only original upload test. Use a dedicated absolute directory.
# The server limits each original to 512 MiB; keep real records out of development.
# DEVELOPMENT_ORIGINAL_STORAGE_ROOT=
MODEL_PROVIDER=gemini
GEMINI_TRANSPORT=developer-api
# Choose an explicit model ID after checking availability and synthetic evaluation.
GEMINI_MODEL_ID=
# Never add a real credential to this example or a VITE_ variable.
GEMINI_API_KEY=
